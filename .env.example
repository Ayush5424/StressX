# StressX Environment Configuration Template
# Copy this file to .env and configure as needed for your environment.

# ==============================================================================
# AI Engine Provider Configuration
# Choose ONE of the following options:
#
# OPTION 1: "fallback" (RECOMMENDED FOR DEPLOYMENT WITHOUT OLLAMA / ZERO DEPENDENCIES)
#   Runs the built-in deterministic autonomous security reasoning engine.
#   Requires NO Ollama, NO GPU, NO API keys, and NO external network calls.
STRESSX_MODEL_PROVIDER=fallback

# OPTION 2: "openai", "groq", or "openrouter" (CLOUD LLM APIs - NO LOCAL DAEMON NEEDED)
#   Uses standard OpenAI-compatible cloud endpoints via API key.
# STRESSX_MODEL_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# STRESSX_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # Or https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1

# OPTION 3: "local" (LOCAL OLLAMA DAEMON - ONLY IF RUNNING OLLAMA LOCALLY)
# STRESSX_MODEL_PROVIDER=local
# STRESSX_OLLAMA_URL=http://localhost:11434
# STRESSX_MODEL_NAME=llama3:8b
# ==============================================================================

# Server / Web Dashboard Configuration
STRESSX_WEB_HOST=0.0.0.0
STRESSX_WEB_PORT=8585

# Logging & Storage
STRESSX_LOG_LEVEL=INFO
STRESSX_REPORTS_DIR=audit_reports
